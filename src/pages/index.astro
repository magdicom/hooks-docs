---
import { Code, TabItem, Tabs } from '@astrojs/starlight/components'
import SiteMetadata from '../components/SiteMetadata.astro'
import '../styles/custom.css'

const title = 'Hooks'
const description = 'Named extension points for PHP with actions, filters, collectors, processors, and renderers.'
const phpActionExample = `use App\\Reports\\ExportOptions;
use Magdicom\\Hooks;

$hooks = new Hooks();
$options = new ExportOptions('sales');
$hooks->addAction('report.export.configure', static function (ExportOptions $options): void {
    $options->includeColumn('customer_region');
});

$hooks->doAction('report.export.configure', $options);`
const laravelActionExample = `use App\\Reports\\ExportOptions;

// The exporter owns this object for the current request.
$options = new ExportOptions('sales');
hooks()->addAction('report.export.configure', static function (ExportOptions $options): void {
    $options->includeColumn('customer_region');
});

hooks()->doAction('report.export.configure', $options);`
const phpFilterExample = `use Magdicom\\Hooks;

$hooks = new Hooks();
$hooks->addFilter('invoice.total', static fn (int $total): int => $total - 1000);
$total = $hooks->applyFilters('invoice.total', 10000);
// 9000 cents`
const laravelFilterExample = `hooks()->addFilter('invoice.total', static fn (int $total): int => $total - 1000);
$total = hooks()->applyFilters('invoice.total', 10000);
// 9000 cents`
const phpCollectorExample = `use Magdicom\\Hooks;

$hooks = new Hooks();
$hooks->addCollector('dashboard.widgets', static fn (string $userId): array => [
    'key' => 'revenue',
    'user_id' => $userId,
]);
$userId = 'user-42';
$widgets = $hooks->collect('dashboard.widgets', $userId);`
const laravelCollectorExample = `hooks()->addCollector('dashboard.widgets', static fn (string $userId): array => [
    'key' => 'revenue',
    'user_id' => $userId,
]);
$userId = 'user-42';
$widgets = hooks()->collect('dashboard.widgets', $userId);`
const phpInstallCommand = 'composer require magdicom/hooks:"^2.0@beta"'
const laravelInstallCommand = 'composer require magdicom/laravel-hooks:"^2.0@beta" magdicom/hooks:"^2.0@beta"'
const currentYear = new Date().getUTCFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — {description}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://hooks.momagdi.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hooks.momagdi.com/" />
    <meta property="og:site_name" content="Hooks" />
    <SiteMetadata />
    <meta property="og:image" content="https://hooks.momagdi.com/hooks-mark.svg" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/hooks-mark.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Hooks home">
        <img src="/hooks-mark.svg" alt="" width="32" height="32" />
        <span>Hooks</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/docs/2.x/">Documentation</a>
        <a href="https://github.com/magdicom/hooks">GitHub</a>
        <a href="/docs/2.x/upgrade">Upgrade</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Extension points for PHP · Hooks 2.x Beta</p>
          <h1 id="hero-title">Build extensible applications without tightly coupling modules.</h1>
          <p class="lede">Run actions, transform values, and collect contributions through clear, named extension points.</p>
          <p class="credibility">Framework-independent at its core, with first-class Laravel integration.</p>
          <div class="button-row" aria-label="Get started">
            <a class="button button-primary" href="/docs/2.x/">Get started</a>
            <a class="button button-secondary" href="https://github.com/magdicom/hooks" target="_blank" rel="noopener noreferrer">View on GitHub</a>
          </div>
        </div>
        <aside class="beta-card" aria-label="Beta status">
          <span class="status-dot" aria-hidden="true"></span>
          <strong>2.x Beta</strong>
          <p>This site covers the current beta APIs. Check the package releases and upgrade guide before moving an existing application to 2.x.</p>
          <a href="https://github.com/magdicom/hooks/releases">View current releases →</a>
        </aside>
      </section>

      <section class="section" aria-labelledby="concepts-title">
        <div class="section-heading">
          <p class="eyebrow">Three useful hook points</p>
          <h2 id="concepts-title">Pick the behavior that fits.</h2>
        </div>
        <div class="concept-grid">
          <article class="concept-card"><span class="concept-number">01</span><h3><a href="/docs/2.x/actions">Actions</a></h3><p>Run callbacks for side effects such as notifications, audit entries, or integrations. Their return values are ignored.</p></article>
          <article class="concept-card"><span class="concept-number">02</span><h3><a href="/docs/2.x/filters">Filters</a></h3><p>Pass one value through a sequence of callbacks. Each callback receives the current value and returns the next one.</p></article>
          <article class="concept-card"><span class="concept-number">03</span><h3><a href="/docs/2.x/collectors">Collectors</a></h3><p>Ask several callbacks for a contribution and keep one result from each. Hooks does not merge or flatten them for you.</p></article>
        </div>
      </section>

      <section class="section common-use-cases" aria-labelledby="use-cases-title">
        <div class="section-heading"><p class="eyebrow">Common use cases</p><h2 id="use-cases-title">Keep integrations out of your core classes.</h2><p class="section-intro">See how actions, filters, collectors, processors, and renderers fit into invoices, dashboards, checkout, navigation, and Laravel applications.</p></div>
        <a class="button button-secondary" href="/docs/2.x/use-cases">Explore practical examples</a>
      </section>

      <section class="section example-section" aria-labelledby="core-example-title">
        <div class="example-copy"><p class="eyebrow">Actions · framework-independent core</p><h2 id="core-example-title">Open a workflow without adding dependencies.</h2><p>An exporter can expose a synchronous configuration point for modules that need to add columns or other options. Unlike a domain event, this hook stays inside the current workflow, so each callback can adjust this export request immediately.</p><a class="text-link" href="/docs/2.x/actions">Learn about actions →</a></div>
        <div class="home-example-tabs">
          <Tabs syncKey="framework">
            <TabItem label="PHP"><Code code={phpActionExample} lang="php" /></TabItem>
            <TabItem label="Laravel"><Code code={laravelActionExample} lang="php" /></TabItem>
          </Tabs>
        </div>
      </section>

      <section class="section example-section example-section-reverse" aria-labelledby="laravel-example-title">
        <div class="example-copy"><p class="eyebrow">Filters · same hook model</p><h2 id="laravel-example-title">Change a value without coupling every module.</h2><p>Filters pass a value through callbacks in order. The PHP and Laravel versions differ only in how the shared Hooks object is reached.</p><a class="text-link" href="/docs/2.x/filters">Learn about filters →</a></div>
        <div class="home-example-tabs">
          <Tabs syncKey="framework">
            <TabItem label="PHP"><Code code={phpFilterExample} lang="php" /></TabItem>
            <TabItem label="Laravel"><Code code={laravelFilterExample} lang="php" /></TabItem>
          </Tabs>
        </div>
      </section>

      <section class="section example-section" aria-labelledby="collector-example-title">
        <div class="example-copy"><p class="eyebrow">Collectors · independent results</p><h2 id="collector-example-title">Let packages contribute their own data.</h2><p>Collectors keep one result from each callback. A dashboard can ask for widgets without knowing which modules provide them.</p><a class="text-link" href="/docs/2.x/collectors">Learn about collectors →</a></div>
        <div class="home-example-tabs">
          <Tabs syncKey="framework">
            <TabItem label="PHP"><Code code={phpCollectorExample} lang="php" /></TabItem>
            <TabItem label="Laravel"><Code code={laravelCollectorExample} lang="php" /></TabItem>
          </Tabs>
        </div>
      </section>

      <section class="section install-section" aria-labelledby="install-title">
        <div class="section-heading"><p class="eyebrow">Install the beta</p><h2 id="install-title">Start with the package you need.</h2></div>
        <div class="install-card install-card-wide">
          <Tabs syncKey="framework">
            <TabItem label="PHP">
              <p>Use the framework-independent core package in any PHP application or reusable package.</p>
              <Code code={phpInstallCommand} lang="bash" />
              <a class="button button-primary" href="https://packagist.org/packages/magdicom/hooks">View core on Packagist</a>
            </TabItem>
            <TabItem label="Laravel">
              <p>Install the wrapper and explicitly permit the matching beta core package.</p>
              <Code code={laravelInstallCommand} lang="bash" />
              <a class="button button-primary" href="https://packagist.org/packages/magdicom/laravel-hooks">View Laravel on Packagist</a>
            </TabItem>
          </Tabs>
        </div>
        <p class="fine-print">Both beta packages are named explicitly so Composer can resolve them. You do not need to change your global minimum-stability setting.</p>
      </section>

      <section class="section comparison-section" aria-labelledby="comparison-title">
        <div class="section-heading"><p class="eyebrow">Choose the right tool</p><h2 id="comparison-title">Different jobs call for different tools.</h2></div>
        <div class="comparison-table" role="table" aria-label="Choosing between Laravel Events, Laravel Pipeline, and Hooks">
          <div class="comparison-row comparison-head" role="row"><strong role="columnheader">Choose</strong><strong role="columnheader">When you need</strong></div>
          <div class="comparison-row" role="row"><strong role="rowheader">Laravel Events</strong><span role="cell">Choose these for domain events, queues, broadcasting, and Laravel event workflows.</span></div>
          <div class="comparison-row" role="row"><strong role="rowheader">Laravel Pipeline</strong><span role="cell">Choose this for a known middleware-style chain where each step passes a value onward.</span></div>
          <div class="comparison-row comparison-highlight" role="row"><strong role="rowheader">Hooks</strong><span role="cell">Choose Hooks for named synchronous extension points, ordered filters, and independent results.</span></div>
        </div>
      </section>

      <section class="closing-panel" aria-labelledby="next-title"><p class="eyebrow">Keep exploring</p><h2 id="next-title">Build your first extension point.</h2><div class="link-grid"><a href="/docs/2.x/concepts">Compare hook types <span>→</span></a><a href="/docs/2.x/processors">Process collector results <span>→</span></a><a href="/docs/2.x/api">Browse the API <span>→</span></a><a href="/docs/2.x/upgrade">Upgrade from 1.x <span>→</span></a><a href="https://github.com/magdicom/hooks">Core on GitHub <span>↗</span></a><a href="https://github.com/magdicom/laravel-hooks">Laravel package on GitHub <span>↗</span></a></div></section>
    </main>

    <footer class="site-footer"><span>Hooks · composable extension points for PHP</span><span>© 2022–{currentYear} <a href="https://momagdi.com" target="_blank" rel="noopener noreferrer">MoMagdi</a>. Hooks is released under the <a href="https://github.com/magdicom/hooks/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer">MIT License</a>.</span><a href="https://github.com/magdicom/hooks/releases">Releases</a></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: var(--hooks-ink); background: var(--sl-color-bg); font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  :global(code), :global(pre) { font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; }
  .site-header, main, .site-footer { max-width: 76rem; margin: 0 auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; }
  .brand { display: inline-flex; gap: 0.6rem; align-items: center; color: var(--hooks-ink); font-size: 1.1rem; font-weight: 800; text-decoration: none; }
  .site-header nav { display: flex; gap: 1.25rem; color: var(--hooks-muted); font-size: 0.9rem; font-weight: 650; }
  .site-header nav a, .text-link { text-underline-offset: 0.2em; text-decoration-thickness: 0.08em; }
  .site-header nav a { text-decoration: none; }
  .site-header nav a:hover, .text-link:hover { color: var(--hooks-blue-hover); }
  main { padding: 0 1.5rem 5rem; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr); gap: 4rem; align-items: end; padding: 6rem 0 7rem; }
  .hero-copy { max-width: 48rem; }
  .eyebrow { margin: 0 0 1rem; color: var(--hooks-blue); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.13em; line-height: 1.4; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 18ch; margin-bottom: 1.5rem; color: var(--hooks-ink); font-size: clamp(3.4rem, 8vw, 7.2rem); line-height: 0.94; letter-spacing: -0.075em; }
  h2 { margin-bottom: 1rem; color: var(--hooks-ink); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; letter-spacing: -0.055em; }
  h3 { margin-bottom: 0.75rem; color: var(--hooks-ink); font-size: 1.25rem; }
  .lede { max-width: 43rem; margin-bottom: 1rem; color: var(--hooks-muted); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.6; }
  .credibility { margin-bottom: 2rem; color: var(--hooks-blue-hover); font-size: 0.95rem; font-weight: 700; }
  .button-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 2.8rem; padding: 0.7rem 1rem; border: 1px solid transparent; border-radius: 0.4rem; font-size: 0.9rem; font-weight: 750; text-decoration: none; }
  .button-primary { color: var(--hooks-on-accent); background: var(--hooks-blue); }
  .button-primary:hover { background: var(--hooks-blue-hover); }
  .button-secondary { border-color: var(--hooks-border); color: var(--hooks-blue-hover); background: transparent; }
  .button-secondary:hover { border-color: var(--hooks-blue); background: var(--hooks-soft); }
  .beta-card { padding: 1.4rem; border: 1px solid var(--hooks-border); border-radius: 0.7rem; background: var(--hooks-surface); box-shadow: 0 1.25rem 2.5rem rgb(15 23 42 / 7%); }
  .status-dot { display: inline-block; width: 0.6rem; height: 0.6rem; margin-right: 0.45rem; border-radius: 50%; background: var(--hooks-sky); box-shadow: 0 0 0 0.25rem var(--hooks-soft); }
  .beta-card p { margin: 0.75rem 0 1rem; color: var(--hooks-muted); line-height: 1.55; }
  .beta-card a, .text-link { color: var(--hooks-blue-hover); font-weight: 750; }
  .section { padding: 5rem 0; border-top: 1px solid var(--hooks-border); }
  .section-heading { max-width: 40rem; margin-bottom: 2rem; }
  .section-intro { max-width: 38rem; color: var(--hooks-muted); line-height: 1.6; }
  .concept-grid, .install-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .concept-card, .install-card { min-width: 0; padding: 1.5rem; border: 1px solid var(--hooks-border); border-radius: 0.6rem; background: var(--hooks-surface); }
  .concept-number { color: var(--hooks-blue); font-family: monospace; font-size: 0.8rem; font-weight: 700; }
  .concept-card h3 { margin-top: 2rem; }
  .concept-card h3 a { text-underline-offset: 0.15em; }
  .concept-card p, .install-card p, .example-copy p { color: var(--hooks-muted); line-height: 1.6; }
  .example-section { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: 4rem; align-items: center; }
  .example-section-reverse { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  .example-section-reverse .example-copy { order: 2; }
  .home-example-tabs { min-width: 0; overflow: hidden; border: 1px solid var(--hooks-muted); border-radius: 0.6rem; color: var(--hooks-ink); background: var(--hooks-code); box-shadow: 0 1.5rem 3rem rgb(15 23 42 / 15%); color-scheme: dark; --sl-color-gray-3: var(--hooks-muted); --sl-color-gray-5: var(--hooks-border); --sl-color-text-accent: var(--hooks-sky); --sl-color-white: var(--hooks-on-accent); --sl-outline-offset-inside: 2px; --ec-codeBg: var(--hooks-code); --ec-codeFg: var(--hooks-ink); --ec-frm-edBg: var(--hooks-code); --ec-frm-edTabBarBg: var(--hooks-code); }
  .home-example-tabs :global(.expressive-code) { margin: 0; border-radius: 0; }
  .home-example-tabs :global(.expressive-code .ec-line :where(span[style^='--']:not([class]))) { color: var(--0, inherit) !important; background-color: var(--0bg, transparent) !important; font-style: var(--0fs, inherit); font-weight: var(--0fw, inherit); text-decoration: var(--0td, inherit); }
  .home-example-tabs :global(.tablist-wrapper) { padding: 0 0.75rem; }
  .home-example-tabs :global([role='tabpanel']) { margin: 0; }
  .home-example-tabs :global(.tab > [role='tab']) { color: var(--hooks-muted); }
  .home-example-tabs :global(.tab [role='tab'][aria-selected='true']) { color: var(--hooks-on-accent); }
  .install-card-wide { min-width: 0; }
  .install-card-wide :global(.expressive-code) { margin: 1.25rem 0; }
  .install-card-wide :global(.expressive-code pre) { font-size: 0.78rem; }
  .code-card { min-width: 0; overflow: hidden; border: 1px solid var(--hooks-muted); border-radius: 0.6rem; color: var(--hooks-ink); background: var(--hooks-code); box-shadow: 0 1.5rem 3rem rgb(15 23 42 / 15%); }
  .code-label { padding: 0.7rem 1rem; border-bottom: 1px solid var(--hooks-muted); color: var(--hooks-sky); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  pre { overflow-x: auto; margin: 0; padding: 1.25rem; font-size: 0.82rem; line-height: 1.7; }
  .install-grid { grid-template-columns: repeat(2, 1fr); }
  .install-card code { display: block; max-width: 100%; overflow-x: auto; margin: 1.25rem 0; padding: 0.8rem; border-radius: 0.35rem; color: var(--hooks-blue-hover); background: var(--hooks-soft); font-size: 0.78rem; white-space: nowrap; }
  .fine-print { margin: 1rem 0 0; color: var(--hooks-muted); font-size: 0.88rem; }
  .comparison-table { overflow: hidden; border: 1px solid var(--hooks-border); border-radius: 0.6rem; background: var(--hooks-surface); }
  .comparison-row { display: grid; grid-template-columns: minmax(10rem, 0.65fr) 1.35fr; gap: 1rem; padding: 1rem 1.25rem; border-top: 1px solid var(--hooks-border); line-height: 1.5; }
  .comparison-row:first-child { border-top: 0; }
  .comparison-head { color: var(--hooks-muted); background: var(--hooks-surface-muted); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .comparison-highlight { border-left: 0.25rem solid var(--hooks-sky); padding-left: 1rem; background: var(--hooks-soft); }
  .closing-panel { margin-top: 5rem; padding: 3rem; border-radius: 0.8rem; color: var(--hooks-ink); background: var(--hooks-code); }
  .closing-panel h2 { color: var(--hooks-ink); }
  .link-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .link-grid a { display: flex; justify-content: space-between; padding: 0.8rem 0; border-bottom: 1px solid var(--hooks-muted); color: var(--hooks-dark-link); text-decoration: none; }
  .link-grid a:hover { color: var(--hooks-sky); }
  .site-footer { display: flex; justify-content: space-between; padding: 1.5rem; border-top: 1px solid var(--hooks-border); color: var(--hooks-muted); font-size: 0.85rem; }
  .site-footer a { color: var(--hooks-blue-hover); }
  :global(a:focus-visible) { outline: 3px solid var(--hooks-focus); outline-offset: 3px; border-radius: 0.2rem; }
  @media (prefers-color-scheme: dark) {
    :global(body) { color: var(--hooks-ink); background: var(--sl-color-bg); }
    .brand, h1, h2, h3 { color: var(--hooks-ink); }
    .site-header nav, .lede, .beta-card p, .concept-card p, .install-card p, .example-copy p, .fine-print, .site-footer { color: var(--hooks-muted); }
    .section-intro { color: var(--hooks-muted); }
    .site-header nav a:hover, .text-link, .site-footer a { color: var(--hooks-sky); }
    .button-secondary { border-color: var(--hooks-border); color: var(--hooks-dark-link); }
    .button-secondary:hover { border-color: var(--hooks-blue); background: var(--hooks-surface-muted); }
    .beta-card, .concept-card, .install-card, .comparison-table { border-color: var(--hooks-border); background: var(--hooks-surface); }
    .section, .site-footer { border-color: var(--hooks-border); }
    .comparison-head { background: var(--hooks-surface-muted); }
    .comparison-row { border-color: var(--hooks-border); }
    .comparison-highlight { background: var(--hooks-highlight-dark); }
    .install-card code { color: var(--hooks-dark-link); background: var(--hooks-surface-muted); }
    :global(a:focus-visible) { outline-color: var(--hooks-focus); }
  }
  @media (max-width: 55rem) { .hero, .example-section, .example-section-reverse { grid-template-columns: 1fr; gap: 2rem; } .example-section-reverse .example-copy { order: initial; } .concept-grid { grid-template-columns: 1fr; } .link-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 40rem) { .site-header { align-items: flex-start; } .site-header nav { flex-direction: column; gap: 0.4rem; align-items: flex-end; } main { padding: 0 1.25rem 3rem; } .hero { padding: 4rem 0 5rem; } h1 { font-size: clamp(3rem, 16vw, 5rem); } .section { padding: 3.5rem 0; } .install-grid, .link-grid { grid-template-columns: 1fr; } .comparison-row { grid-template-columns: 1fr; gap: 0.25rem; } .closing-panel { padding: 2rem 1.25rem; } .site-footer { flex-direction: column; gap: 0.5rem; } }
</style>
