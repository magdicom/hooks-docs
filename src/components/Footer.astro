---
import EditLink from '@astrojs/starlight/components/EditLink.astro'
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro'
import Pagination from '@astrojs/starlight/components/Pagination.astro'

const currentYear = new Date().getUTCFullYear()
const licenseUrl = 'https://github.com/magdicom/hooks/blob/main/LICENSE.md'
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <p class="creator-attribution">
    © 2022–{currentYear} <a href="https://momagdi.com" target="_blank" rel="noopener noreferrer">MoMagdi</a>.
    Hooks is released under the <a href={licenseUrl} target="_blank" rel="noopener noreferrer">MIT License</a>.
  </p>

</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }

    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .creator-attribution {
      margin: 0;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      text-align: center;
    }

    .creator-attribution a {
      color: inherit;
      text-underline-offset: 0.2em;
    }

    .creator-attribution a:hover {
      color: var(--sl-color-text-accent);
    }

  }
</style>
