---
import Search from '@astrojs/starlight/components/Search.astro'
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro'
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro'
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
---

<div class="header" data-header>
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="primary-nav" aria-label="Primary navigation">
    <a href="/docs/2.x/" aria-label="Hooks documentation">Docs</a>
    <a href="/docs/2.x/concepts">Concepts</a>
    <a href="/docs/2.x/laravel">Laravel</a>
    <a href="/docs/2.x/upgrade">Upgrade</a>
    <details>
      <summary>2.x Beta</summary>
      <div class="version-menu">
        <a href="/docs/2.x/">2.x Beta</a>
        <a href="/docs/2.x/upgrade#version-1-reference">1.x (historical)</a>
      </div>
    </details>
  </nav>
  <div class="actions sl-flex print:hidden">
    <Search />
    <div class="social-icons"><SocialIcons /></div>
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .title-wrapper {
    min-width: max-content;
  }

  .primary-nav {
    display: none;
    gap: 1rem;
    align-items: center;
    font-size: 0.875rem;
  }

  .primary-nav a,
  .primary-nav summary {
    padding: 0.35rem 0.2rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
    cursor: pointer;
  }

  .primary-nav a:hover,
  .primary-nav summary:hover {
    color: var(--sl-color-text-accent);
  }

  .primary-nav details {
    position: relative;
  }

  .version-menu {
    position: absolute;
    z-index: 10;
    top: 1.75rem;
    right: 0;
    display: grid;
    gap: 0.5rem;
    min-width: 9rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
  }

  .version-menu a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: 0.25rem;
  }

  .version-menu a:hover {
    background: var(--sl-color-accent-low);
  }

  .actions {
    gap: 0.75rem;
    align-items: center;
    min-width: max-content;
  }

  .social-icons {
    display: none;
  }

  @media (min-width: 64rem) {
    .primary-nav,
    .social-icons {
      display: flex;
    }
  }

  @media (max-width: 32rem) {
    .header {
      gap: 0.5rem;
    }

    .actions {
      gap: 0.35rem;
    }

    .social-icons {
      display: none;
    }
  }
</style>
